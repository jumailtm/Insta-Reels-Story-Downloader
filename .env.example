# Copy this file to .env for local development. Never put real credentials here.
MAIN_BOT_TOKEN=<telegram-bot-token>
WEBHOOK_BASE_URL=https://your-project.vercel.app
WEBHOOK_SECRET=<random-letters-numbers-underscores-or-hyphens>

DOWNLOAD_DIR=data/downloads
MAX_UPLOAD_MB=49

# Configure at most one of these. Both contain sensitive session credentials.
# INSTAGRAM_COOKIES_FILE=instagram-cookies.txt
# INSTAGRAM_COOKIES_B64=<base64-encoded-instagram-only-cookie-file>
